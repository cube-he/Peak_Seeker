# === AMap JS API (frontend map rendering, used by 校区位置 tab) ===
# Get from https://console.amap.com/dev/key/app — type: Web端(JS API)
# Stage 1: keys live here for dev. Stage 2: also bind production domain
# whitelist in AMap console so the keys cannot be reused from other origins.
NEXT_PUBLIC_AMAP_JS_KEY=
NEXT_PUBLIC_AMAP_JS_SECURITY=

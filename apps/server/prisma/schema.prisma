// ==================== 批次志愿配置 ====================

model BatchConfig {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // 基本信息
  year     Int    @db.SmallInt
  province String @db.VarChar(50)
  batch    String @db.VarChar(100) // 批次名称，如 "本科提前批A段"
  examType String @map("exam_type") @db.VarChar(50) // 物理/历史/不分科目

  // 志愿模式
  volunteerMode    String  @map("volunteer_mode") @db.VarChar(20) // parallel(平行志愿) / sequential(顺序志愿)
  maxGroupCount    Int     @map("max_group_count") // 最大院校专业组数
  maxMajorPerGroup Int     @default(6) @map("max_major_per_group") // 每组最大专业数
  hasAdjustOption  Boolean @default(true) @map("has_adjust_option") // 是否有调剂选项

  // 投档规则
  filingRatio String? @map("filing_ratio") @db.VarChar(20) // 调档比例，如 "1:1" 或 "≤120%"

  // 录取顺序(数字越小越先录取)
  admissionOrder Int @map("admission_order")

  // 包含的招生类型说明
  description String? @db.Text

  // 同分排序规则(JSON格式)
  tiebreakRules Json? @map("tiebreak_rules")

  // 新增字段
  eligibilityRules Json? @map("eligibility_rules")
  algorithmConfig  Json? @map("algorithm_config")

  @@unique([year, province, batch, examType])
  @@index([year])
  @@index([province])
  @@map("batch_configs")
}

// ==================== AI 配置 ====================

model AiConfig {
  id        String   @id @default(uuid()) @db.VarChar(36)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // 配置信息
  name            String  @db.VarChar(100)
  provider        String  @db.VarChar(50) // openai, deepseek, qwen, custom
  apiKeyEncrypted String  @map("api_key_encrypted") @db.Text
  apiBaseUrl      String? @map("api_base_url") @db.VarChar(500)
  modelName       String? @map("model_name") @db.VarChar(100)

  // 状态
  isDefault Boolean @default(false) @map("is_default")
  isActive  Boolean @default(true) @map("is_active")

  // 子模型
  models AiConfigModel[]

  @@map("ai_configs")
}

model AiConfigModel {
  id        String   @id @default(uuid()) @db.VarChar(36)
  createdAt DateTime @default(now()) @map("created_at")

  // 关联
  configId String   @map("config_id") @db.VarChar(36)
  config   AiConfig @relation(fields: [configId], references: [id], onDelete: Cascade)

  // 模型信息
  modelName   String  @map("model_name") @db.VarChar(100)
  displayName String? @map("display_name") @db.VarChar(100)
  isDefault   Boolean @default(false) @map("is_default")

  @@index([configId])
  @@map("ai_config_models")
}


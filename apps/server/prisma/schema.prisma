// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// ==================== 枚举定义 ====================

// --- 保留的旧枚举（向后兼容） ---

enum VipLevel {
  FREE
  BASIC
  PREMIUM
  EXPERT
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

// --- 替换旧 UserRole ---

enum Role {
  ADMIN
  TEACHER
  STUDENT
}

// --- 替换旧 PlanStatus（扩展生命周期） ---

enum PlanStatus {
  DRAFT
  PENDING_REVIEW
  REVIEWING
  APPROVED
  STUDENT_CONFIRMED
  REJECTED
  FINALIZED
  PUBLISHED
  OUTDATED
}

// --- 新增枚举 ---

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum StudentStatus {
  ACTIVE
  GRADUATED
  DROPPED
  SUSPENDED
}

enum StudentIntakeStatus {
  DRAFT
  SUBMITTED
  NEEDS_CHANGES
  VERIFIED
}

// 避免与 BatchConfig/ScoreSegment 的 examType String 冲突
enum NewExamType {
  PHYSICS
  HISTORY
  COMPREHENSIVE_LIBERAL
  COMPREHENSIVE_SCIENCE
}

enum PriorityMode {
  UNIVERSITY_FIRST
  MAJOR_FIRST
  CITY_FIRST
  BALANCED
}

enum CareerPlan {
  POSTGRADUATE
  EMPLOYMENT
  ABROAD
  PUBLIC_SERVANT
  UNDECIDED
}

enum StayPreference {
  LOCAL_ONLY
  PREFER_LOCAL
  NO_PREFERENCE
  PREFER_OUTSIDE
}

enum AcceptLevel {
  STRICT
  MODERATE
  RELAXED
  UNDECIDED
}

enum TuitionBudget {
  LOW
  MEDIUM
  HIGH
  UNLIMITED
}

enum Batch {
  EARLY_BATCH
  FIRST_BATCH
  SECOND_BATCH
  SPECIAL_BATCH
}

enum ExamSource {
  REAL_EXAM
  MOCK_EXAM
  ESTIMATED
}

enum Gradient {
  CHONG
  WEN
  BAO
}

enum Cleanliness {
  CLEAN
  MINOR_ISSUE
  MODERATE_ISSUE
  MAJOR_ISSUE
}

enum ReviewerRole {
  TEACHER
  SUPERVISOR
  STUDENT
}

enum ReviewAction {
  APPROVE
  REJECT
  REQUEST_CHANGE
  COMMENT
  STUDENT_CONFIRM
  STUDENT_REQUEST_CHANGE
}

enum RecommendType {
  AI_GENERATED
  MANUAL
  HYBRID
}

// ==================== 学生信息采集 V1 新增枚举 ====================

enum PoliticalStatus {
  PARTY_MEMBER
  LEAGUE_MEMBER
  MASSES
}

enum BonusPolicyStatus {
  NONE
  HAS_BONUS
  UNKNOWN
}

enum RemoteAreaAcceptance {
  ABSOLUTELY_NO
  BACKUP_ONLY
  FAMOUS_OK
  GOOD_MAJOR_OK
}

enum ColdMajorAcceptance {
  ABSOLUTELY_NO
  FAMOUS_OK
  DEVELOPED_AREA_OK
  GOOD_PROSPECT_OK
}

enum FormFiller {
  STUDENT
  PARENT
  TOGETHER
}

// ==================== 院校相关 ====================

model University {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // 基本信息
  name     String  @db.VarChar(200)
  code     String? @unique @db.VarChar(50)
  province String? @db.VarChar(50)
  city     String? @db.VarChar(100)

  // 院校属性
  type          String? @map("university_type") @db.VarChar(50)
  level         String? @map("university_level") @db.VarChar(50)
  runningLevel  String? @map("running_level") @db.VarChar(50)
  runningNature String? @map("running_nature") @db.VarChar(50)

  // 院校标签
  isDoubleFirstClass Boolean @default(false) @map("is_double_first_class")
  is985              Boolean @default(false) @map("is_985")
  is211              Boolean @default(false) @map("is_211")
  tags               Json?   @map("university_tags")
  grade              String? @map("university_grade") @db.VarChar(50)

  // 学科建设
  disciplineEvaluationLevel String? @map("discipline_evaluation_level") @db.Text
  hasMasterProgram          Boolean @default(false) @map("has_master_program")
  hasDoctoralProgram        Boolean @default(false) @map("has_doctoral_program")
  masterProgramCount        Int?    @map("master_program_count")
  masterPrograms            Json?   @map("master_programs")
  doctoralProgramCount      Int?    @map("doctoral_program_count")
  doctoralPrograms          Json?   @map("doctoral_programs")

  // 其他属性
  campusArea               Decimal? @map("campus_area") @db.Decimal(10, 2)
  transferDifficulty       String?  @map("transfer_difficulty") @db.Text
  militaryTrainingDuration String?  @map("military_training_duration") @db.VarChar(50)
  isFeatured               Boolean  @default(false) @map("is_featured")

  // 新增字段
  department     String? @db.VarChar(200)
  ranking        String? @db.VarChar(50)
  admissionGuide String? @map("admission_guide") @db.Text
  renameHistory  String? @map("rename_history") @db.Text
  postgradRate   String? @map("postgrad_rate") @db.VarChar(50)

  // 软科排名
  softRating  String? @map("soft_rating") @db.VarChar(50)
  softRanking Int?    @map("soft_ranking")
  softRankList     String? @map("soft_rank_list") @db.VarChar(20)
  softCategory     String? @map("soft_category") @db.VarChar(50)
  softCategoryRank Int?    @map("soft_category_rank")
  softRankYear     Int?    @map("soft_rank_year") @db.SmallInt

  // 人口统计
  maleRatio   Int?    @map("male_ratio")
  femaleRatio Int?    @map("female_ratio")
  createdYear String? @map("created_year") @db.VarChar(20)
  logoUrl     String? @map("logo_url") @db.VarChar(500)

  // A类学科数量
  aClassDisciplineCount Int? @map("a_class_discipline_count")

  // 多维排名
  rankingAlumni Int? @map("ranking_alumni")
  rankingQS     Int? @map("ranking_qs")
  rankingUSNews Int? @map("ranking_us_news")

  // 满意度
  satisfactionOverall Float? @map("satisfaction_overall")
  satisfactionLife    Float? @map("satisfaction_life")
  satisfactionEnviron Float? @map("satisfaction_environ")
  satisfactionCount   Int?   @map("satisfaction_count")

  // 就业
  employmentRate   String? @map("employment_rate") @db.VarChar(50)
  furtherStudyRate String? @map("further_study_rate") @db.VarChar(50)
  avgSalary        String? @map("avg_salary") @db.VarChar(50)
  topEmployers     String? @map("top_employers") @db.Text

  // 招生章程
  charterInfo Json? @map("charter_info")

  // 备注
  notes String? @db.Text

  // === Geo (主校区/注册地兜底坐标) ===
  address      String?   @db.VarChar(500)
  latitude     Decimal?  @db.Decimal(9, 6)
  longitude    Decimal?  @db.Decimal(9, 6)
  geoStatus    String    @default("pending") @map("geo_status") @db.VarChar(20)
  geoSource    String?   @map("geo_source") @db.VarChar(50)
  geoUpdatedAt DateTime? @map("geo_updated_at")

  // 院校位次冗余字段（科类拆分，由 apps/server/scripts/backfill-university-ranks.ts 回填）
  minScorePhysics Int? @map("min_score_physics")
  minRankPhysics  Int? @map("min_rank_physics")
  minScoreHistory Int? @map("min_score_history")
  minRankHistory  Int? @map("min_rank_history")
  predRankPhysics Int? @map("pred_rank_physics")
  predRankHistory Int? @map("pred_rank_history")

  // 院校基础补充（来自 01_基础名录）
  firstClassCategory          String?  @map("first_class_category") @db.VarChar(50)
  hasGradSchool               Boolean  @default(false) @map("has_grad_school")
  hasRecommendQualification   Boolean  @default(false) @map("has_recommend_qualification")
  is101Plan                   Boolean  @default(false) @map("is_101_plan")
  isQiangji                   Boolean  @default(false) @map("is_qiangji")
  website                     String?  @db.VarChar(500)
  admissionWebsite            String?  @map("admission_website") @db.VarChar(500)
  admissionPhone              String?  @map("admission_phone") @db.VarChar(200)
  admissionEmail              String?  @map("admission_email") @db.VarChar(200)
  cityTier                    String?  @map("city_tier") @db.VarChar(20)
  universityTier              String?  @map("university_tier") @db.VarChar(50)
  universityBackground        String?  @map("university_background") @db.Text

  // 学科建设补充（来自 02_详情扩展）
  firstClassDisciplineCount   Int?     @map("first_class_discipline_count")
  nationalFeatureMajorCount   Int?     @map("national_feature_major_count")
  nationalKeyDisciplineCount  Int?     @map("national_key_discipline_count")
  description                 String?  @db.Text
  heatScore                   Int?     @map("heat_score")
  bannerUrl                   String?  @map("banner_url") @db.VarChar(500)

  // 多维排名补充（来自 03_历年排名）
  rankingTimes                Int?     @map("ranking_times")

  campuses  UniversityCampus[]
  geoIssues UniversityGeoIssue[]

  // 关联
  enrollmentPlans  EnrollmentPlan[]
  admissionRecords AdmissionRecord[]
  favorites        Favorite[]
  rankPredictions  RankPrediction[]

  @@index([province])
  @@index([city])
  @@index([type])
  @@index([isDoubleFirstClass])
  @@index([is985])
  @@index([is211])
  @@index([minRankPhysics])
  @@index([minRankHistory])
  @@index([predRankPhysics])
  @@index([predRankHistory])
  @@index([softRanking])
  @@index([heatScore])
  @@index([rankingAlumni])
  @@index([rankingQS])
  @@index([rankingUSNews])
  @@index([rankingTimes])
  @@index([aClassDisciplineCount])
  @@index([firstClassDisciplineCount])
  @@map("universities")
}

// ==================== 专业相关 ====================

model Major {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // 基本信息
  name String  @db.VarChar(200)
  code String? @db.VarChar(50)

  // 专业分类
  category   String? @map("major_category") @db.VarChar(100)
  level      String? @map("major_level") @db.VarChar(50)
  discipline String? @db.VarChar(100)
  type       String? @map("major_type") @db.VarChar(50)

  // 专业属性
  notes        String? @map("major_notes") @db.Text
  isRestricted Boolean @default(false) @map("is_restricted")

  // 专业水平和评级
  majorLevel String? @map("major_level_detail") @db.VarChar(100)
  softRating String? @map("major_soft_rating") @db.VarChar(50)

  // 本地学位点
  localMasterPoint   Boolean @default(false) @map("local_master_point")
  localDoctoralPoint Boolean @default(false) @map("local_doctoral_point")

  // 专业详情
  description            String? @map("major_description") @db.Text
  maleRatio              Int?    @map("male_ratio")
  femaleRatio            Int?    @map("female_ratio")
  studentScale           String? @map("student_scale") @db.VarChar(50)
  careerDirections       Json?   @map("career_directions")
  postgraduateDirections Json?   @map("postgraduate_directions")
  satisfactionScore      Float?  @map("satisfaction_score")
  coreCourses            Json?   @map("core_courses")
  degree                 String? @map("degree") @db.VarChar(100)
  standardDuration       String? @map("standard_duration") @db.VarChar(20)

  // 就业信息
  employmentRate      Decimal? @map("employment_rate") @db.Decimal(5, 2)
  avgSalary           Int?     @map("avg_salary")
  employmentDirection String?  @map("employment_direction") @db.Text

  // 关联
  enrollmentPlans  EnrollmentPlan[]
  admissionRecords AdmissionRecord[]
  favorites        Favorite[]

  @@index([category])
  @@index([level])
  @@index([discipline])
  @@map("majors")
}

// ==================== 招生计划 ====================

model EnrollmentPlan {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // 关联
  universityId Int        @map("university_id")
  university   University @relation(fields: [universityId], references: [id])
  majorId      Int        @map("major_id")
  major        Major      @relation(fields: [majorId], references: [id])

  // 招生年份和省份
  year     Int    @db.SmallInt
  province String @db.VarChar(50)

  // 招生计划
  planCount Int?    @map("plan_count")
  planNotes String? @map("plan_notes") @db.Text

  // 招生要求
  batch               String  @default("") @db.VarChar(50)
  level               String? @db.VarChar(50)
  subjects            String  @default("") @db.VarChar(100)
  subjectRequirements String? @map("subject_requirements") @db.Text
  duration            String? @db.VarChar(20)
  tuition             Int?
  isSinoForeign       Boolean @default(false) @map("is_sino_foreign")

  // 自然主键字段（冗余存储用于唯一约束和展示）
  recruitType String @default("") @map("recruit_type") @db.VarChar(100)
  majorCode   String @default("") @map("major_code") @db.VarChar(50)
  majorName   String @default("") @map("major_name") @db.VarChar(200)

  // 学位点信息
  localMasterPoint   String? @map("local_master_point") @db.VarChar(200)
  localDoctoralPoint String? @map("local_doctoral_point") @db.VarChar(200)

  // 专业组信息
  groupCode      String  @default("") @map("group_code") @db.VarChar(50)
  groupName      String? @map("group_name") @db.VarChar(200)
  groupMajors    String? @map("group_majors") @db.Text
  groupPlanCount Int?    @map("group_plan_count")

  // 招生属性
  isNew    Boolean @default(false) @map("is_new")
  oldBatch String? @map("old_batch") @db.VarChar(50)

  // 院校+专业维度评价
  disciplineEval    String? @map("discipline_eval") @db.VarChar(50)
  isNationalFeature Boolean @default(false) @map("is_national_feature")
  majorRanking      String? @map("major_ranking") @db.VarChar(100)
  majorHonor        String? @map("major_honor") @db.Text

  @@unique([universityId, subjects, batch, recruitType, groupCode, majorCode, majorName, year])
  @@index([year])
  @@index([province])
  @@index([universityId])
  @@index([majorId])
  @@index([batch])
  @@index([year, province, batch])
  @@map("enrollment_plans")
}

// ==================== 录取数据 ====================

model AdmissionRecord {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // 关联
  universityId Int        @map("university_id")
  university   University @relation(fields: [universityId], references: [id])
  majorId      Int        @map("major_id")
  major        Major      @relation(fields: [majorId], references: [id])

  // 年份和省份
  year     Int    @db.SmallInt
  province String @db.VarChar(50)

  // 专业录取数据
  majorMinScore       Int? @map("major_min_score")
  majorMinRank        Int? @map("major_min_rank")
  majorAvgScore       Int? @map("major_avg_score")
  majorAvgRank        Int? @map("major_avg_rank")
  majorMaxScore       Int? @map("major_max_score")
  majorMaxRank        Int? @map("major_max_rank")
  majorAdmissionCount Int? @map("major_admission_count")

  // 专业组录取数据
  groupMinScore       Int? @map("group_min_score")
  groupMinRank        Int? @map("group_min_rank")
  groupAdmissionCount Int? @map("group_admission_count")

  // 投档数据
  filingMinScore Int? @map("filing_min_score")
  filingMinRank  Int? @map("filing_min_rank")

  // 自然主键字段
  recruitType String @default("") @map("recruit_type") @db.VarChar(100)
  groupCode   String @default("") @map("group_code") @db.VarChar(50)
  majorCode   String @default("") @map("major_code") @db.VarChar(50)
  majorName   String @default("") @map("major_name") @db.VarChar(200)

  // 科目和批次信息
  subjects String @default("") @db.VarChar(50)
  batch    String @default("") @db.VarChar(50)

  // 院校整体录取数据
  universityMinScore       Int? @map("university_min_score")
  universityMinRank        Int? @map("university_min_rank")
  universityAvgScore       Int? @map("university_avg_score")
  universityAvgRank        Int? @map("university_avg_rank")
  universityMaxScore       Int? @map("university_max_score")
  universityMaxRank        Int? @map("university_max_rank")
  universityAdmissionCount Int? @map("university_admission_count")

  @@unique([universityId, subjects, batch, recruitType, groupCode, majorCode, majorName, year])
  @@index([year])
  @@index([province])
  @@index([universityId])
  @@index([majorId])
  @@index([majorMinScore])
  @@index([majorMinRank])
  @@index([batch])
  @@index([year, province, batch])
  @@map("admission_records")
}

// ==================== 用户相关 ====================

model User {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // 账号信息
  username     String  @unique @db.VarChar(50)
  email        String? @unique @db.VarChar(100)
  phone        String? @unique @db.VarChar(20)
  passwordHash String  @map("password_hash") @db.VarChar(255)

  // 个人信息
  realName  String?   @map("real_name") @db.VarChar(100)
  gender    String?   @db.VarChar(10)
  birthDate DateTime? @map("birth_date") @db.Date
  avatar    String?   @db.VarChar(500)
  ethnicity String?   @db.VarChar(50)

  // 考生信息（旧字段，向后兼容）
  province String? @db.VarChar(50)
  city     String? @db.VarChar(100)
  examType String? @map("exam_type") @db.VarChar(50)
  examYear Int?    @map("exam_year") @db.SmallInt
  score    Int?    @db.SmallInt
  rank     Int?
  subjects Json?
  batch    String? @db.VarChar(50)

  // 兴趣偏好（旧字段，向后兼容）
  preferredProvinces       Json?   @map("preferred_provinces")
  preferredCities          Json?   @map("preferred_cities")
  preferredMajors          Json?   @map("preferred_majors")
  preferredUniversityTypes Json?   @map("preferred_university_types")
  careerDirection          String? @map("career_direction") @db.Text

  // 会员信息
  vipLevel    VipLevel  @default(FREE) @map("vip_level")
  vipExpireAt DateTime? @map("vip_expire_at")

  // 角色（新枚举）
  role Role @default(STUDENT)

  // 权限覆盖
  permissionOverrides Json? @map("permission_overrides")

  // 登录信息
  lastLoginAt DateTime? @map("last_login_at")
  lastLoginIp String?   @map("last_login_ip") @db.VarChar(50)

  // 关联（旧）
  volunteerPlans  VolunteerPlan[] @relation("LegacyUserPlans")
  searchHistories SearchHistory[]
  favorites       Favorite[]
  comparisons     Comparison[]
  orders          Order[]

  // 关联（新）
  teacherProfile TeacherProfile?
  studentProfile StudentProfile?
  createdPlans   VolunteerPlan[] @relation("PlanCreator")
  reviews        PlanReview[]
  reviewDrafts   PlanReviewDraft[]
  notifications  Notification[]
  auditLogs      AuditLog[]

  @@index([province])
  @@index([examYear])
  @@index([vipLevel])
  @@map("users")
}

// ==================== 教师档案 ====================

model TeacherProfile {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // 关联用户
  userId Int  @unique @map("user_id")
  user   User @relation(fields: [userId], references: [id])

  // 教师信息
  school       String? @db.VarChar(200)
  isSupervisor Boolean @default(false) @map("is_supervisor")

  // 关联学生
  students StudentProfile[]

  @@map("teacher_profiles")
}

// ==================== 学生档案 ====================

model StudentProfile {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // 关联用户
  userId Int  @unique @map("user_id")
  user   User @relation(fields: [userId], references: [id])

  // 管理关系
  teacherId Int?            @map("teacher_id")
  teacher   TeacherProfile? @relation(fields: [teacherId], references: [id])

  // --- 基本信息 ---
  province          String?       @default("四川") @db.VarChar(50)
  city              String?       @db.VarChar(100)
  county            String?       @db.VarChar(100)
  highSchool        String?       @map("high_school") @db.VarChar(200)
  classInfo         String?       @map("class_info") @db.VarChar(50)
  status            StudentStatus       @default(ACTIVE)
  intakeStatus      StudentIntakeStatus @default(DRAFT) @map("intake_status")
  intakeSubmittedAt DateTime?           @map("intake_submitted_at")
  intakeReviewedAt  DateTime?           @map("intake_reviewed_at")
  intakeReviewedBy  Int?                @map("intake_reviewed_by")
  intakeReviewComment String?           @map("intake_review_comment") @db.Text
  idNumberEncrypted String?       @map("id_number_encrypted") @db.VarChar(500)
  parentPhone       String?       @map("parent_phone") @db.VarChar(20)
  isRural           Boolean       @default(false) @map("is_rural")

  // --- 高考所在地（① 老师独占）---
  examLocationProvince String? @map("exam_location_province") @db.VarChar(50)
  examLocationCity     String? @map("exam_location_city") @db.VarChar(100)
  examLocationCounty   String? @map("exam_location_county") @db.VarChar(100)

  // --- 政治面貌（② 学生可编辑）---
  politicalStatus PoliticalStatus? @map("political_status")

  // --- 考试成绩 ---
  examType         NewExamType? @map("exam_type")
  examYear         Int?         @map("exam_year") @db.SmallInt
  totalScore       Int?         @map("total_score") @db.SmallInt
  provincialRank   Int?         @map("provincial_rank")
  examSource       ExamSource?  @map("exam_source")
  subjectScores    Json?        @map("subject_scores")
  firstChoice      String?      @map("first_choice") @db.VarChar(50)
  reChoices        Json?        @map("re_choices")
  scoreChinese     Int?         @map("score_chinese") @db.SmallInt
  scoreMath        Int?         @map("score_math") @db.SmallInt
  scoreEnglish     Int?         @map("score_english") @db.SmallInt
  scoreFirstChoice Int?         @map("score_first_choice") @db.SmallInt
  scoreSub1        Int?         @map("score_sub1") @db.SmallInt
  scoreSub2        Int?         @map("score_sub2") @db.SmallInt
  strongSubjects   Json?        @map("strong_subjects")
  weakSubjects     Json?        @map("weak_subjects")

  // --- 身体条件 ---
  height         Decimal? @db.Decimal(5, 1)
  weight         Decimal? @db.Decimal(5, 1)
  /// @deprecated 用 visionLeft/visionRight + visionLeftCorrected/visionRightCorrected 取代
  vision         String?  @db.VarChar(50)
  colorBlind     Boolean  @default(false) @map("color_blind")
  colorWeak      Boolean  @default(false) @map("color_weak")
  physicalLimits Json?    @map("physical_limits")


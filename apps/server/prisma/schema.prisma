// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// ==================== 枚举定义 ====================

// --- 保留的旧枚举（向后兼容） ---

enum VipLevel {
  FREE
  BASIC
  PREMIUM
  EXPERT
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

// --- 替换旧 UserRole ---

enum Role {
  ADMIN
  TEACHER
  STUDENT
}

// --- 替换旧 PlanStatus（扩展生命周期） ---

enum PlanStatus {
  DRAFT
  PENDING_REVIEW
  REVIEWING
  APPROVED
  REJECTED
  FINALIZED
  PUBLISHED
  OUTDATED
}

// --- 新增枚举 ---

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum StudentStatus {
  ACTIVE
  GRADUATED
  DROPPED
  SUSPENDED
}

// 避免与 BatchConfig/ScoreSegment 的 examType String 冲突
enum NewExamType {
  PHYSICS
  HISTORY
  COMPREHENSIVE_LIBERAL
  COMPREHENSIVE_SCIENCE
}

enum PriorityMode {
  UNIVERSITY_FIRST
  MAJOR_FIRST
  CITY_FIRST
  BALANCED
}

enum CareerPlan {
  POSTGRADUATE
  EMPLOYMENT
  ABROAD
  PUBLIC_SERVANT
  UNDECIDED
}

enum StayPreference {
  LOCAL_ONLY
  PREFER_LOCAL
  NO_PREFERENCE
  PREFER_OUTSIDE
}

enum AcceptLevel {
  STRICT
  MODERATE
  RELAXED
  UNDECIDED
}

enum TuitionBudget {
  LOW
  MEDIUM
  HIGH
  UNLIMITED
}

enum Batch {
  EARLY_BATCH
  FIRST_BATCH
  SECOND_BATCH
  SPECIAL_BATCH
}

enum ExamSource {
  REAL_EXAM
  MOCK_EXAM
  ESTIMATED
}

enum Gradient {
  CHONG
  WEN
  BAO
}

enum Cleanliness {
  CLEAN
  MINOR_ISSUE
  MODERATE_ISSUE
  MAJOR_ISSUE
}

enum ReviewerRole {
  TEACHER
  SUPERVISOR
}

enum ReviewAction {
  APPROVE
  REJECT
  REQUEST_CHANGE
  COMMENT
}

enum RecommendType {
  AI_GENERATED
  MANUAL
  HYBRID
}

// ==================== 院校相关 ====================

model University {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // 基本信息
  name     String  @db.VarChar(200)
  code     String? @unique @db.VarChar(50)
  province String? @db.VarChar(50)
  city     String? @db.VarChar(100)

  // 院校属性
  type          String? @map("university_type") @db.VarChar(50)
  level         String? @map("university_level") @db.VarChar(50)
  runningLevel  String? @map("running_level") @db.VarChar(50)
  runningNature String? @map("running_nature") @db.VarChar(50)

  // 院校标签
  isDoubleFirstClass Boolean @default(false) @map("is_double_first_class")
  is985              Boolean @default(false) @map("is_985")
  is211              Boolean @default(false) @map("is_211")
  tags               Json?   @map("university_tags")
  grade              String? @map("university_grade") @db.VarChar(50)

  // 学科建设
  disciplineEvaluationLevel String? @map("discipline_evaluation_level") @db.VarChar(50)
  hasMasterProgram          Boolean @default(false) @map("has_master_program")
  hasDoctoralProgram        Boolean @default(false) @map("has_doctoral_program")
  masterProgramCount        Int?    @map("master_program_count")
  masterPrograms            Json?   @map("master_programs")
  doctoralProgramCount      Int?    @map("doctoral_program_count")
  doctoralPrograms          Json?   @map("doctoral_programs")

  // 其他属性
  campusArea               Decimal? @map("campus_area") @db.Decimal(10, 2)
  transferDifficulty       String?  @map("transfer_difficulty") @db.Text
  militaryTrainingDuration String?  @map("military_training_duration") @db.VarChar(50)
  isFeatured               Boolean  @default(false) @map("is_featured")

  // 新增字段
  department     String? @db.VarChar(200)
  ranking        String? @db.VarChar(50)
  admissionGuide String? @map("admission_guide") @db.Text
  renameHistory  String? @map("rename_history") @db.Text
  postgradRate   String? @map("postgrad_rate") @db.VarChar(50)

  // 软科排名
  softRating  String? @map("soft_rating") @db.VarChar(50)
  softRanking Int?    @map("soft_ranking")

  // 备注
  notes String? @db.Text

  // 关联
  enrollmentPlans  EnrollmentPlan[]
  admissionRecords AdmissionRecord[]
  favorites        Favorite[]

  @@index([province])
  @@index([city])
  @@index([type])
  @@index([isDoubleFirstClass])
  @@index([is985])
  @@index([is211])
  @@map("universities")
}

// ==================== 专业相关 ====================

model Major {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // 基本信息
  name String  @db.VarChar(200)
  code String? @db.VarChar(50)

  // 专业分类
  category   String? @map("major_category") @db.VarChar(100)
  level      String? @map("major_level") @db.VarChar(50)
  discipline String? @db.VarChar(100)
  type       String? @map("major_type") @db.VarChar(50)

  // 专业属性
  notes        String? @map("major_notes") @db.Text
  isRestricted Boolean @default(false) @map("is_restricted")

  // 专业水平和评级
  majorLevel String? @map("major_level_detail") @db.VarChar(100)
  softRating String? @map("major_soft_rating") @db.VarChar(50)

  // 本地学位点
  localMasterPoint   Boolean @default(false) @map("local_master_point")
  localDoctoralPoint Boolean @default(false) @map("local_doctoral_point")

  // 就业信息
  employmentRate      Decimal? @map("employment_rate") @db.Decimal(5, 2)
  avgSalary           Int?     @map("avg_salary")
  employmentDirection String?  @map("employment_direction") @db.Text

  // 关联
  enrollmentPlans  EnrollmentPlan[]
  admissionRecords AdmissionRecord[]
  favorites        Favorite[]

  @@index([category])
  @@index([level])
  @@index([discipline])
  @@map("majors")
}

// ==================== 招生计划 ====================

model EnrollmentPlan {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // 关联
  universityId Int        @map("university_id")
  university   University @relation(fields: [universityId], references: [id])
  majorId      Int        @map("major_id")
  major        Major      @relation(fields: [majorId], references: [id])

  // 招生年份和省份
  year     Int    @db.SmallInt
  province String @db.VarChar(50)

  // 招生计划
  planCount Int?    @map("plan_count")
  planNotes String? @map("plan_notes") @db.Text

  // 招生要求
  batch               String? @db.VarChar(50)
  level               String? @db.VarChar(50)
  subjects            String? @db.VarChar(100)
  subjectRequirements String? @map("subject_requirements") @db.Text
  duration            String? @db.VarChar(20)
  tuition             Int?
  isSinoForeign       Boolean @default(false) @map("is_sino_foreign")

  // 学位点信息
  localMasterPoint   String? @map("local_master_point") @db.VarChar(200)
  localDoctoralPoint String? @map("local_doctoral_point") @db.VarChar(200)

  // 专业组信息
  groupCode      String? @map("group_code") @db.VarChar(50)
  groupName      String? @map("group_name") @db.VarChar(200)
  groupMajors    String? @map("group_majors") @db.Text
  groupPlanCount Int?    @map("group_plan_count")

  // 招生属性
  isNew    Boolean @default(false) @map("is_new")
  oldBatch String? @map("old_batch") @db.VarChar(50)

  // 院校+专业维度评价
  disciplineEval    String? @map("discipline_eval") @db.VarChar(50)
  isNationalFeature Boolean @default(false) @map("is_national_feature")
  majorRanking      String? @map("major_ranking") @db.VarChar(100)
  majorHonor        String? @map("major_honor") @db.Text

  @@unique([universityId, majorId, year, province])
  @@index([year])
  @@index([province])
  @@index([universityId])
  @@index([majorId])
  @@index([batch])
  @@index([year, province, batch])
  @@map("enrollment_plans")
}

// ==================== 录取数据 ====================

model AdmissionRecord {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // 关联
  universityId Int        @map("university_id")
  university   University @relation(fields: [universityId], references: [id])
  majorId      Int        @map("major_id")
  major        Major      @relation(fields: [majorId], references: [id])

  // 年份和省份
  year     Int    @db.SmallInt
  province String @db.VarChar(50)

  // 专业录取数据
  majorMinScore       Int? @map("major_min_score")
  majorMinRank        Int? @map("major_min_rank")
  majorAvgScore       Int? @map("major_avg_score")
  majorAvgRank        Int? @map("major_avg_rank")
  majorMaxScore       Int? @map("major_max_score")
  majorMaxRank        Int? @map("major_max_rank")
  majorAdmissionCount Int? @map("major_admission_count")

  // 专业组录取数据
  groupMinScore       Int? @map("group_min_score")
  groupMinRank        Int? @map("group_min_rank")
  groupAdmissionCount Int? @map("group_admission_count")

  // 投档数据
  filingMinScore Int? @map("filing_min_score")
  filingMinRank  Int? @map("filing_min_rank")

  // 科目和批次信息
  subjects String? @db.VarChar(50)
  batch    String? @db.VarChar(50)

  // 院校整体录取数据
  universityMinScore       Int? @map("university_min_score")
  universityMinRank        Int? @map("university_min_rank")
  universityAvgScore       Int? @map("university_avg_score")
  universityAvgRank        Int? @map("university_avg_rank")
  universityMaxScore       Int? @map("university_max_score")
  universityMaxRank        Int? @map("university_max_rank")
  universityAdmissionCount Int? @map("university_admission_count")

  @@unique([universityId, majorId, year, province])
  @@index([year])
  @@index([province])
  @@index([universityId])
  @@index([majorId])
  @@index([majorMinScore])
  @@index([majorMinRank])
  @@index([batch])
  @@index([year, province, batch])
  @@map("admission_records")
}

// ==================== 用户相关 ====================

model User {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // 账号信息
  username     String  @unique @db.VarChar(50)
  email        String? @unique @db.VarChar(100)
  phone        String? @unique @db.VarChar(20)
  passwordHash String  @map("password_hash") @db.VarChar(255)

  // 个人信息
  realName  String?   @map("real_name") @db.VarChar(100)
  gender    String?   @db.VarChar(10)
  birthDate DateTime? @map("birth_date") @db.Date
  avatar    String?   @db.VarChar(500)
  ethnicity String?   @db.VarChar(50)

  // 考生信息（旧字段，向后兼容）
  province String? @db.VarChar(50)
  city     String? @db.VarChar(100)
  examType String? @map("exam_type") @db.VarChar(50)
  examYear Int?    @map("exam_year") @db.SmallInt
  score    Int?    @db.SmallInt
  rank     Int?
  subjects Json?
  batch    String? @db.VarChar(50)

  // 兴趣偏好（旧字段，向后兼容）
  preferredProvinces       Json?   @map("preferred_provinces")
  preferredCities          Json?   @map("preferred_cities")
  preferredMajors          Json?   @map("preferred_majors")
  preferredUniversityTypes Json?   @map("preferred_university_types")
  careerDirection          String? @map("career_direction") @db.Text

  // 会员信息
  vipLevel    VipLevel  @default(FREE) @map("vip_level")
  vipExpireAt DateTime? @map("vip_expire_at")

  // 角色（新枚举）
  role Role @default(STUDENT)

  // 权限覆盖
  permissionOverrides Json? @map("permission_overrides")

  // 登录信息
  lastLoginAt DateTime? @map("last_login_at")
  lastLoginIp String?   @map("last_login_ip") @db.VarChar(50)

  // 关联（旧）
  volunteerPlans  VolunteerPlan[] @relation("LegacyUserPlans")
  searchHistories SearchHistory[]
  favorites       Favorite[]
  comparisons     Comparison[]
  orders          Order[]

  // 关联（新）
  teacherProfile TeacherProfile?
  studentProfile StudentProfile?
  createdPlans   VolunteerPlan[] @relation("PlanCreator")
  reviews        PlanReview[]
  notifications  Notification[]
  auditLogs      AuditLog[]

  @@index([province])
  @@index([examYear])
  @@index([vipLevel])
  @@map("users")
}

// ==================== 教师档案 ====================

model TeacherProfile {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // 关联用户
  userId Int  @unique @map("user_id")
  user   User @relation(fields: [userId], references: [id])

  // 教师信息
  school       String? @db.VarChar(200)
  isSupervisor Boolean @default(false) @map("is_supervisor")

  // 关联学生
  students StudentProfile[]

  @@map("teacher_profiles")
}

// ==================== 学生档案 ====================

model StudentProfile {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // 关联用户
  userId Int  @unique @map("user_id")
  user   User @relation(fields: [userId], references: [id])

  // 管理关系
  teacherId Int?            @map("teacher_id")
  teacher   TeacherProfile? @relation(fields: [teacherId], references: [id])

  // --- 基本信息 ---
  province          String?       @default("四川") @db.VarChar(50)
  city              String?       @db.VarChar(100)
  highSchool        String?       @map("high_school") @db.VarChar(200)
  classInfo         String?       @map("class_info") @db.VarChar(50)
  status            StudentStatus @default(ACTIVE)
  idNumberEncrypted String?       @map("id_number_encrypted") @db.VarChar(500)
  parentPhone       String?       @map("parent_phone") @db.VarChar(20)
  isRural           Boolean       @default(false) @map("is_rural")

  // --- 考试成绩 ---
  examType         NewExamType? @map("exam_type")
  examYear         Int?         @map("exam_year") @db.SmallInt
  totalScore       Int?         @map("total_score") @db.SmallInt
  provincialRank   Int?         @map("provincial_rank")
  examSource       ExamSource?  @map("exam_source")
  subjectScores    Json?        @map("subject_scores")
  firstChoice      String?      @map("first_choice") @db.VarChar(50)
  reChoices        Json?        @map("re_choices")
  scoreChinese     Int?         @map("score_chinese") @db.SmallInt
  scoreMath        Int?         @map("score_math") @db.SmallInt
  scoreEnglish     Int?         @map("score_english") @db.SmallInt
  scoreFirstChoice Int?         @map("score_first_choice") @db.SmallInt
  scoreSub1        Int?         @map("score_sub1") @db.SmallInt
  scoreSub2        Int?         @map("score_sub2") @db.SmallInt
  strongSubjects   Json?        @map("strong_subjects")
  weakSubjects     Json?        @map("weak_subjects")

  // --- 身体条件 ---
  height         Decimal? @db.Decimal(5, 1)
  weight         Decimal? @db.Decimal(5, 1)
  vision         String?  @db.VarChar(50)
  colorBlind     Boolean  @default(false) @map("color_blind")
  colorWeak      Boolean  @default(false) @map("color_weak")
  physicalLimits Json?    @map("physical_limits")

  // --- 升学规划 ---
  careerPlan       CareerPlan?     @map("career_plan")
  priorityMode     PriorityMode?   @map("priority_mode")
  stayPreference   StayPreference? @map("stay_preference")
  careerDirection  String?         @map("career_direction") @db.VarChar(500)
  militaryInterest Boolean         @default(false) @map("military_interest")
  teacherInterest  Boolean         @default(false) @map("teacher_interest")

  // --- 正向偏好 ---
  stayInProvince           StayPreference? @map("stay_in_province")
  preferredProvinces       Json?           @map("preferred_provinces")
  preferredCities          Json?           @map("preferred_cities")
  preferredMajors          Json?           @map("preferred_majors")
  preferredUniversities    Json?           @map("preferred_universities")
  preferredMajorCategories Json?           @map("preferred_major_categories")
  preferredUniversityTypes Json?           @map("preferred_university_types")
  preferredTags            Json?           @map("preferred_tags")

  // --- 反向排除 ---
  excludedProvinces    Json?        @map("excluded_provinces")
  excludedCities       Json?        @map("excluded_cities")
  excludedUniversities Json?        @map("excluded_universities")
  excludedMajors       Json?        @map("excluded_majors")
  acceptLevel          AcceptLevel? @map("accept_level")

  // --- 经济条件 ---
  tuitionBudget     TuitionBudget? @map("tuition_budget")
  acceptSinoForeign Boolean        @default(false) @map("accept_sino_foreign")
  acceptPrivate     AcceptLevel    @default(UNDECIDED) @map("accept_private")
  acceptCooperation AcceptLevel    @default(UNDECIDED) @map("accept_cooperation")
  specialProgram    Json?          @map("special_program")
  otherRequirements String?        @map("other_requirements") @db.Text

  // --- 兴趣性格 ---
  interests       Json?
  personalityType String? @map("personality_type") @db.VarChar(50)
  selfDescription String? @map("self_description") @db.Text

  // --- 管理字段 ---
  tags        Json?
  serviceYear Int   @default(2026) @map("service_year") @db.SmallInt
  dataVersion Int   @default(0) @map("data_version")

  // 关联
  volunteerPlans VolunteerPlan[]

  @@index([teacherId])
  @@index([province])
  @@index([examYear])
  @@index([status])
  @@index([examType, totalScore])
  @@index([serviceYear])
  @@map("student_profiles")
}

// ==================== 志愿方案 ====================

model VolunteerPlan {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // 新关联：学生档案（必填）
  studentId Int            @map("student_id")
  student   StudentProfile @relation(fields: [studentId], references: [id])

  // 新关联：创建者
  createdById Int  @map("created_by_id")
  createdBy   User @relation("PlanCreator", fields: [createdById], references: [id])

  // 旧关联：保留向后兼容
  userId     Int?  @map("user_id")
  legacyUser User? @relation("LegacyUserPlans", fields: [userId], references: [id])

  // 方案信息（保留旧字段）
  name     String  @db.VarChar(200)
  year     Int     @db.SmallInt
  province String? @db.VarChar(50)

  // 旧方案内容（JSON）— Prisma 字段名改为 legacyItems，DB 列名不变
  legacyItems Json?   @map("items")
  strategy    String? @db.VarChar(50)

  // 方案状态（扩展枚举）
  status     PlanStatus @default(DRAFT)
  isFavorite Boolean    @default(false) @map("is_favorite")

  // 批次与考试来源
  batch      Batch?      @map("plan_batch")
  examSource ExamSource? @map("exam_source")

  // 版本链
  versionNo       Int             @default(1) @map("version_no")
  parentVersionId Int?            @map("parent_version_id")
  parent          VolunteerPlan?  @relation("PlanVersionChain", fields: [parentVersionId], references: [id])
  children        VolunteerPlan[] @relation("PlanVersionChain")
  versionNote     String?         @map("version_note") @db.VarChar(500)

  // 算法参数快照
  scoreUsed       Int?          @map("score_used") @db.SmallInt
  rankUsed        Int?          @map("rank_used")
  algorithmParams Json?         @map("algorithm_params")
  priorityMode    PriorityMode? @map("priority_mode")
  rangeUp         Int?          @map("range_up")
  rangeDown       Int?          @map("range_down")
  binSize         Int?          @map("bin_size")
  totalGroups     Int?          @map("total_groups")
  bonusRules      Json?         @map("bonus_rules")

  // AI分析（保留旧字段）
  aiScore    Decimal? @map("ai_score") @db.Decimal(5, 2)
  aiAnalysis Json?    @map("ai_analysis")
  riskLevel  String?  @map("risk_level") @db.VarChar(20)

  // 定稿与导出
  isFinal     Boolean   @default(false) @map("is_final")
  finalizedAt DateTime? @map("finalized_at")
  finalizedBy Int?      @map("finalized_by")
  exportCount Int       @default(0) @map("export_count")
  dataVersion Int       @default(0) @map("data_version")

  // 备注（保留旧字段）
  notes    String? @db.Text
  examNote String? @map("exam_note") @db.VarChar(500)

  // 新关联
  planItems   PlanItem[]
  reviews     PlanReview[]
  evaluations PlanEvaluation[]

  @@unique([studentId, batch, versionNo])
  @@index([studentId])
  @@index([createdById])
  @@index([userId])
  @@index([year])
  @@index([status])
  @@index([parentVersionId])
  @@map("volunteer_plans")
}

// ==================== 方案志愿项 ====================

model PlanItem {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // 关联方案
  planId Int           @map("plan_id")
  plan   VolunteerPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  // 志愿序号
  sequence Int @db.SmallInt

  // 梯度
  gradient Gradient

  // 院校信息
  universityId   Int     @map("university_id")
  universityName String  @map("university_name") @db.VarChar(200)
  universityCode String? @map("university_code") @db.VarChar(50)

  // 专业组信息
  groupCode String? @map("group_code") @db.VarChar(50)
  groupName String? @map("group_name") @db.VarChar(200)

  // 专业信息
  majorId   Int     @map("major_id")
  majorName String  @map("major_name") @db.VarChar(200)
  majorCode String? @map("major_code") @db.VarChar(50)

  // 锚定专业与专业组
  anchorMajor        String  @map("anchor_major") @db.VarChar(200)
  groupMajorCount    Int     @map("group_major_count")
  recommendedOrder   String? @map("recommended_order") @db.VarChar(500)
  fullMajorRanking   Json?   @map("full_major_ranking")
  subjectRequirement String? @map("subject_requirement") @db.VarChar(200)

  // 院校属性快照
  schoolNature String? @map("school_nature") @db.VarChar(100)
  schoolTags   String? @map("school_tags") @db.VarChar(500)

  // 是否服从调剂
  acceptAdjust Boolean @default(true) @map("accept_adjust")

  // 历史录取数据快照（25年专业组维度）
  score25Group     Int? @map("score_25_group")
  rank25Group      Int? @map("rank_25_group")
  // 历史录取数据快照（25年专业维度）
  score25Major     Int? @map("score_25_major")
  rank25Major      Int? @map("rank_25_major")
  // 历史录取数据快照（24年专业维度）
  score24Major     Int? @map("score_24_major")
  rank24Major      Int? @map("rank_24_major")
  // 兼容旧字段
  lastYearMinScore Int? @map("last_year_min_score")
  lastYearMinRank  Int? @map("last_year_min_rank")
  lastYearAvgScore Int? @map("last_year_avg_score")
  lastYearAvgRank  Int? @map("last_year_avg_rank")
  avgMinRank3y     Int? @map("avg_min_rank_3y")

  // 当年招生计划
  planCount Int? @map("plan_count")
  tuition   Int?

  // 洁净度
  cleanliness Cleanliness?

  // 推荐理由 / 风险提示（拆分为三个独立字段）
  selectionReason  String? @map("selection_reason") @db.Text
  riskWarning      String? @map("risk_warning") @db.Text
  adjustmentAdvice String? @map("adjustment_advice") @db.VarChar(500)

  // 手动修改追踪
  isManuallyModified Boolean @default(false) @map("is_manually_modified")
  originalItemId     Int?    @map("original_item_id")

  // 综合评分
  compositeScore Decimal? @map("composite_score") @db.Decimal(6, 2)
  scoreBreakdown Json?    @map("score_breakdown")

  @@unique([planId, sequence])
  @@index([planId])
  @@index([universityId])
  @@index([majorId])
  @@map("plan_items")
}

// ==================== 方案审核 ====================

model PlanReview {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")

  // 关联方案
  planId Int           @map("plan_id")
  plan   VolunteerPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  // 审核人
  reviewerId   Int          @map("reviewer_id")
  reviewer     User         @relation(fields: [reviewerId], references: [id])
  reviewerRole ReviewerRole @map("reviewer_role")

  // 审核动作
  action  ReviewAction
  comment String?      @db.Text

  // 逐项批注（JSON: { sequence: number, annotation: string }[]）
  itemAnnotations Json? @map("item_annotations")

  @@index([planId])
  @@index([reviewerId])
  @@map("plan_reviews")
}

// ==================== 方案评估（录取追踪） ====================

model PlanEvaluation {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")

  // 关联方案
  planId Int           @map("plan_id")
  plan   VolunteerPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  // 关联录取结果
  admissionResultId Int?             @map("admission_result_id")
  admissionResult   AdmissionResult? @relation(fields: [admissionResultId], references: [id])

  // 匹配信息
  matchedItemSequence Int?     @map("matched_item_sequence") @db.SmallInt
  matchedGradient     String?  @map("matched_gradient") @db.VarChar(50)
  isInPlan            Boolean  @default(false) @map("is_in_plan")
  evaluationScore     Decimal? @map("evaluation_score") @db.Decimal(5, 2)
  evaluationNote      String?  @map("evaluation_note") @db.Text

  @@index([planId])
  @@index([admissionResultId])
  @@map("plan_evaluations")
}

// ==================== 查询历史 ====================

model SearchHistory {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")

  // 关联
  userId Int?  @map("user_id")
  user   User? @relation(fields: [userId], references: [id])


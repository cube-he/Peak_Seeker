// ==================== 批次志愿配置 ====================

model BatchConfig {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // 基本信息
  year     Int    @db.SmallInt
  province String @db.VarChar(50)
  batch    String @db.VarChar(100) // 批次名称，如 "本科提前批A段"
  examType String @map("exam_type") @db.VarChar(50) // 物理/历史/不分科目

  // 志愿模式
  volunteerMode    String  @map("volunteer_mode") @db.VarChar(20) // parallel(平行志愿) / sequential(顺序志愿)
  maxGroupCount    Int     @map("max_group_count") // 最大院校专业组数
  maxMajorPerGroup Int     @default(6) @map("max_major_per_group") // 每组最大专业数
  hasAdjustOption  Boolean @default(true) @map("has_adjust_option") // 是否有调剂选项

  // 投档规则
  filingRatio String? @map("filing_ratio") @db.VarChar(20) // 调档比例，如 "1:1" 或 "≤120%"

  // 录取顺序(数字越小越先录取)
  admissionOrder Int @map("admission_order")

  // 包含的招生类型说明
  description String? @db.Text

  // 同分排序规则(JSON格式)
  tiebreakRules Json? @map("tiebreak_rules")

  // 新增字段
  eligibilityRules Json? @map("eligibility_rules")
  algorithmConfig  Json? @map("algorithm_config")

  // 政策约束（2026-05-07 加入，对应四川 2026 招生政策）
  // 该批次投档时是否享受加分（民语为主/加授民文/预科/不分省艺术/高水平运动队 = false）
  bonusEligible    Boolean @default(true) @map("bonus_eligible")
  // 该批次允许的降分上限（分），0 = 不可降；e.g. 农村医学定向 20、川大国防预科 90
  discountAllowed  Int     @default(0)    @map("discount_allowed")

  @@unique([year, province, batch, examType])
  @@index([year])
  @@index([province])
  @@map("batch_configs")
}

// ==================== AI 配置 ====================

model AiConfig {
  id        String   @id @default(uuid()) @db.VarChar(36)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // 配置信息
  name            String  @db.VarChar(100)
  provider        String  @db.VarChar(50) // openai, deepseek, qwen, custom
  apiKeyEncrypted String  @map("api_key_encrypted") @db.Text
  apiBaseUrl      String? @map("api_base_url") @db.VarChar(500)
  modelName       String? @map("model_name") @db.VarChar(100)

  // 状态
  isDefault Boolean @default(false) @map("is_default")
  isActive  Boolean @default(true) @map("is_active")

  // 子模型
  models AiConfigModel[]

  @@map("ai_configs")
}

model AiConfigModel {
  id        String   @id @default(uuid()) @db.VarChar(36)
  createdAt DateTime @default(now()) @map("created_at")

  // 关联
  configId String   @map("config_id") @db.VarChar(36)
  config   AiConfig @relation(fields: [configId], references: [id], onDelete: Cascade)

  // 模型信息
  modelName   String  @map("model_name") @db.VarChar(100)
  displayName String? @map("display_name") @db.VarChar(100)
  isDefault   Boolean @default(false) @map("is_default")

  @@index([configId])
  @@map("ai_config_models")
}

// ==================== 专业推荐 ====================

model MajorRecommendation {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // 关联学生
  studentProfileId Int @map("student_profile_id")

  // 推荐类型
  recommendType RecommendType @map("recommend_type")

  // 推荐内容
  majorCategory String  @map("major_category") @db.VarChar(100)
  majorName     String  @map("major_name") @db.VarChar(200)
  matchScore    Decimal @map("match_score") @db.Decimal(5, 2)
  reasons       Json?

  @@index([studentProfileId])
  @@index([recommendType])
  @@map("major_recommendations")
}

// ==================== 专业名称映射 ====================

model MajorNameMapping {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")

  // 原始名称 → 标准名称
  rawName      String  @map("raw_name") @db.VarChar(200)
  standardName String  @map("standard_name") @db.VarChar(200)
  source       String? @db.VarChar(100)

  @@unique([rawName, source])
  @@index([rawName])
  @@index([standardName])
  @@map("major_name_mappings")
}

// ==================== 征集志愿记录 ====================

model SupplementaryRecord {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // 基本信息
  year        Int    @db.SmallInt
  province    String @db.VarChar(50)
  batch       String @db.VarChar(100)
  roundNumber Int    @default(1) @map("round_number") @db.SmallInt

  // 院校专业信息
  universityId   Int     @map("university_id")
  universityName String  @map("university_name") @db.VarChar(200)
  majorId        Int?    @map("major_id")
  majorName      String? @map("major_name") @db.VarChar(200)

  // 征集信息
  planCount      Int?    @map("plan_count")
  requirements   String? @db.Text
  filingMinScore Int?    @map("filing_min_score")
  filingMinRank  Int?    @map("filing_min_rank")

  @@index([year, province, batch])
  @@index([universityId])
  @@map("supplementary_records")
}

// ==================== 征集志愿汇总（物理表，TRUNCATE+INSERT 刷新） ====================

model SupplementarySummary {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")

  // 维度
  year         Int    @db.SmallInt
  province     String @db.VarChar(50)
  batch        String @db.VarChar(100)
  universityId Int    @map("university_id")

  // 汇总数据
  totalRounds       Int      @default(0) @map("total_rounds") @db.SmallInt
  totalPlanCount    Int      @default(0) @map("total_plan_count")
  supplementaryRate Decimal? @map("supplementary_rate") @db.Decimal(5, 2)

  @@unique([year, province, batch, universityId])
  @@index([universityId])
  @@map("supplementary_summaries")
}

// ==================== 通知 ====================

model Notification {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")

  // 接收人
  userId Int  @map("user_id")
  user   User @relation(fields: [userId], references: [id])

  // 通知内容
  title   String  @db.VarChar(200)
  content String  @db.Text
  type    String  @db.VarChar(50)
  refType String? @map("ref_type") @db.VarChar(50)
  refId   Int?    @map("ref_id")

  // 状态
  isRead Boolean   @default(false) @map("is_read")
  readAt DateTime? @map("read_at")

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}

// ==================== 审计日志 ====================

model AuditLog {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")

  // 操作人
  userId Int?  @map("user_id")
  user   User? @relation(fields: [userId], references: [id])

  // 操作信息
  action     String  @db.VarChar(100)
  entityType String  @map("entity_type") @db.VarChar(50)
  entityId   Int?    @map("entity_id")
  oldValue   Json?   @map("old_value")
  newValue   Json?   @map("new_value")
  ipAddress  String? @map("ip_address") @db.VarChar(50)

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ==================== 文件记录 ====================

model FileRecord {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")

  // 文件信息
  fileName    String @map("file_name") @db.VarChar(500)
  fileSize    Int    @map("file_size")
  mimeType    String @map("mime_type") @db.VarChar(100)
  storagePath String @map("storage_path") @db.VarChar(1000)
  storageType String @default("local") @map("storage_type") @db.VarChar(50)

  // 关联
  uploadedById Int?    @map("uploaded_by_id")
  entityType   String? @map("entity_type") @db.VarChar(50)
  entityId     Int?    @map("entity_id")

  @@index([uploadedById])
  @@index([entityType, entityId])
  @@map("file_records")
}

// ==================== 投档记录 ====================

model FilingRecord {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // 基本信息
  year     Int    @db.SmallInt
  province String @db.VarChar(50)
  batch    String @db.VarChar(100)
  examType String @map("exam_type") @db.VarChar(50)

  // 院校信息
  universityId   Int     @map("university_id")
  universityName String  @map("university_name") @db.VarChar(200)
  groupCode      String? @map("group_code") @db.VarChar(50)

  // 投档数据
  filingMinScore Int? @map("filing_min_score")
  filingMinRank  Int? @map("filing_min_rank")
  filingCount    Int? @map("filing_count")
  planCount      Int? @map("plan_count")

  @@index([year, province, batch])
  @@index([universityId])
  @@map("filing_records")
}

// ==================== 录取结果（学生实际录取） ====================

model AdmissionResult {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // 关联学生
  studentProfileId Int @map("student_profile_id")

  // 录取信息
  year           Int     @db.SmallInt
  universityName String  @map("university_name") @db.VarChar(200)
  majorName      String  @map("major_name") @db.VarChar(200)
  batch          String  @db.VarChar(100)
  isAdjusted     Boolean @default(false) @map("is_adjusted")

  // 方案评估
  evaluations PlanEvaluation[]

  @@index([studentProfileId])
  @@index([year])
  @@map("admission_results")
}

// ==================== 方案分享链接 ====================

model PlanShareLink {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")

  // 关联方案
  planId Int @map("plan_id")

  // 分享信息
  token     String    @unique @db.VarChar(100)
  expiresAt DateTime? @map("expires_at")
  isActive  Boolean   @default(true) @map("is_active")
  viewCount Int       @default(0) @map("view_count")

  @@index([planId])
  @@index([token])
  @@map("plan_share_links")
}

// ==================== 算法配置 ====================

model AlgorithmConfig {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // 配置名称
  name    String @db.VarChar(100)
  version String @db.VarChar(20)

  // 算法参数
  weights      Json
  thresholds   Json
  gradientRule Json @map("gradient_rule")

  // 状态
  isDefault Boolean @default(false) @map("is_default")
  isActive  Boolean @default(true) @map("is_active")

  @@unique([name, version])
  @@map("algorithm_configs")
}

// ==================== 高考时间轴 ====================

model TimelineEvent {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  key       String    @db.VarChar(30) // 'gaokao' | 'score_query' | 'early_batch' | 'regular_batch' | 'vocational_batch'
  name      String    @db.VarChar(30) // "高考"、"本科提前批"等
  status    String    @db.VarChar(30) // 'countdown' | 'estimated' | 'filling' | 'in_progress' | 'collecting_1' | 'collecting_2' | 'collecting_3' | 'available' | 'completed'
  sortOrder Int       @map("sort_order")
  startDate DateTime? @map("start_date")
  endDate   DateTime? @map("end_date")
  detail    Json? // 征集截止时间、子批次信息等
  sourceUrl String?   @map("source_url") @db.VarChar(500)
  year      Int

  @@unique([key, year])
  @@index([year])
  @@map("timeline_events")
}

// ==================== 位次预测 ====================

model ProvinceYearStat {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  province String @db.VarChar(50)
  year     Int    @db.SmallInt
  examType String @map("exam_type") @db.VarChar(50) // canonical: 物理 | 历史 | 全部

  registrants     Int? // 报名人数（教育考试院通报）
  examineesActual Int? @map("examinees_actual") // 实际参考人数
  rankedCount     Int? @map("ranked_count") // 一分一段最大累计（自推算）

  source      String   @db.VarChar(500)
  fetchedDate DateTime @map("fetched_date")
  notes       String?  @db.Text

  @@unique([province, year, examType])
  @@index([year])
  @@map("province_year_stats")
}

model RankPrediction {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  universityId Int        @map("university_id")
  university   University @relation(fields: [universityId], references: [id])

  groupCode   String @map("group_code") @db.VarChar(50)
  batch       String @db.VarChar(50)
  recruitType String @map("recruit_type") @db.VarChar(100)
  subjects    String @db.VarChar(50) // canonical 物理|历史
  targetYear  Int    @map("target_year") @db.SmallInt

  pointRank        Int?   @map("point_rank")
  conservativeRank Int?   @map("conservative_rank")
  optimisticRank   Int?   @map("optimistic_rank")
  basisYears       Json   @map("basis_years") // [2024, 2023, 2022]
  confidence       String @db.VarChar(20) // high|medium|low

  computedAt DateTime @default(now()) @map("computed_at")

  @@unique([universityId, groupCode, batch, recruitType, subjects, targetYear], name: "rank_pred_natural_key")
  @@index([targetYear, subjects])
  @@map("rank_predictions")
}

// ==================== 校区 ====================

model UniversityCampus {
  id           Int      @id @default(autoincrement())
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  universityId Int      @map("university_id")

  name     String  @db.VarChar(100)
  isMain   Boolean @default(false) @map("is_main")
  province String? @db.VarChar(50)
  city     String? @db.VarChar(100)
  district String? @db.VarChar(100)

  address      String?   @db.VarChar(500)
  latitude     Decimal?  @db.Decimal(9, 6)
  longitude    Decimal?  @db.Decimal(9, 6)
  geoStatus    String    @default("pending") @map("geo_status") @db.VarChar(20)
  geoSource    String?   @map("geo_source") @db.VarChar(50)
  geoUpdatedAt DateTime? @map("geo_updated_at")

  distanceToCityCenter Int?     @map("distance_to_city_center")
  nearestSubwayMeters  Int?     @map("nearest_subway_meters")
  nearestAirportKm     Decimal? @map("nearest_airport_km") @db.Decimal(6, 2)

  discoveredFrom String? @map("discovered_from") @db.VarChar(50)

  university University                 @relation(fields: [universityId], references: [id], onDelete: Cascade)
  pois       UniversityCampusPoi[]
  facilities UniversityCampusFacility[]

  @@unique([universityId, name])
  @@index([universityId, geoStatus])
  @@map("university_campuses")
}

// ==================== 校区 POI ====================

model UniversityCampusPoi {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  campusId  Int      @map("campus_id")

  amapId   String  @map("amap_id") @db.VarChar(50)
  name     String  @db.VarChar(200)
  category String  @db.VarChar(50)
  typecode String? @db.VarChar(100)

  latitude  Decimal @db.Decimal(9, 6)
  longitude Decimal @db.Decimal(9, 6)
  address   String? @db.VarChar(500)
  distance  Int
  metadata  Json?

  source    String   @default("amap_around") @db.VarChar(50)
  fetchedAt DateTime @map("fetched_at")
  obsolete  Boolean  @default(false)

  campus UniversityCampus @relation(fields: [campusId], references: [id], onDelete: Cascade)

  @@unique([campusId, amapId])
  @@index([campusId, category, distance])
  @@map("university_campus_pois")
}

// ==================== 校区配套设施 ====================

model UniversityCampusFacility {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  campusId  Int      @map("campus_id")

  category String @db.VarChar(30)
  name     String @db.VarChar(200)

  latitude  Decimal @db.Decimal(9, 6)
  longitude Decimal @db.Decimal(9, 6)
  address   String? @db.VarChar(500)

  amapId         String @map("amap_id") @db.VarChar(50)
  typecode       String @db.VarChar(100)
  distanceMeters Int    @map("distance_meters")

  confidence  String @db.VarChar(10)
  matchMethod String @map("match_method") @db.VarChar(30)
  source      String @default("amap_text") @db.VarChar(30)

  fetchedAt DateTime @default(now()) @map("fetched_at")
  obsolete  Boolean  @default(false)

  campus UniversityCampus @relation(fields: [campusId], references: [id], onDelete: Cascade)

  @@unique([campusId, amapId])
  @@index([campusId, category])
  @@index([category, confidence])
  @@map("university_campus_facilities")
}

// ==================== 地理问题追踪 ====================

model UniversityGeoIssue {
  id           Int      @id @default(autoincrement())
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  universityId Int      @map("university_id")
  campusId     Int?     @map("campus_id")

  issueType String @map("issue_type") @db.VarChar(50)
  detail    Json?

  status      String    @default("pending") @db.VarChar(20)
  retryCount  Int       @default(0) @map("retry_count")
  lastRetryAt DateTime? @map("last_retry_at")
  resolvedAt  DateTime? @map("resolved_at")
  resolvedBy  String?   @map("resolved_by") @db.VarChar(50)

  university University @relation(fields: [universityId], references: [id], onDelete: Cascade)

  @@index([universityId])
  @@index([status])
  @@index([issueType])
  @@map("university_geo_issues")
}

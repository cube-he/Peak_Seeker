# 数据库 (MySQL)
DATABASE_URL="mysql://root:password@localhost:3306/volunteer_helper"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_QUEUE_DB=1

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=30m
JWT_REFRESH_EXPIRES_IN=7d

# Claude API
CLAUDE_API_KEY=your-claude-api-key

# 应用配置
PORT=3001
NODE_ENV=development

# CORS (逗号分隔多个来源)
CORS_ORIGIN=http://localhost:3000

# 慢请求监控阈值 (毫秒)
SLOW_REQUEST_THRESHOLD_MS=1000

# OCR 微服务
OCR_SERVICE_URL=http://127.0.0.1:8100

# 支付配置 (可选)
WECHAT_APP_ID=
WECHAT_MCH_ID=
WECHAT_API_KEY=
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=

# JWT 配置
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long

# Claude API
CLAUDE_API_KEY=your_claude_api_key

# 前端 API 地址（生产环境改为实际域名）
NEXT_PUBLIC_API_URL=http://your-domain.com/api/v1

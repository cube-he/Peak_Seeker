# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
.next/
out/
build/

# ETL 数据快照 / 大文件:不进 git。这些是 scripts/* 跑出来的中间产物,
# 可重新生成,且单文件经常 50-100+ MB,GitHub 100MB 硬限会直接拒推。
scripts/data-processing/output/
scripts/data_integration/three_layer_output/
scripts/import-data/import-data.sql

# Production SSH key:本地保留,git 不跟踪(见 cube-he/Peak_Seeker README)
*.pem

# Environment files
.env
.env.local
.env.*.local

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
apps/server/logs/

# Testing
coverage/

# Prisma
prisma/migrations/*_migration_lock.toml

# Temporary files
*.tmp
*.temp
.cache/

# Claude flow (开发工具)
.claude-flow/

# Superpowers brainstorm artifacts (transient mockups + state)
.superpowers/brainstorm/

# Python 缓存
__pycache__/
*.pyc

# 临时分析产物（下划线前缀约定）
scripts/_*.json
scripts/_*.txt

# 参考资料文件（不需要上传）
*.xlsx
*.docx
# Allow test fixtures
!scripts/data_integration/tests/fixtures/*.xlsx
# Allow server templates (e.g. 接待单 模板)
!apps/server/templates/*.xlsx
*_files/
优志愿*.html
掌上高考*.html
阳光高考*.html

# 原始数据目录（大文件，不入库）— 仅排除根 data/ 和 scripts 子目录里的 data/
/data/
scripts/**/data/
# 注：apps/web/src/data 是前端选项数据（民族/省市县），需要入库

# 数据处理中间产物（保留最终output）
scripts/data-processing/output/*.sql
scripts/data-processing/output/admission_records.json
scripts/data-processing/output/admission_records_filled.json
scripts/data-processing/output/enrollment_plans.json
scripts/data-processing/output/enrollment_plans_enriched.json
scripts/data-processing/output/universities.json
scripts/data-processing/output/majors.json
scripts/data-processing/output/majors_enriched.json
scripts/data-processing/output/*_report.json

# TypeScript 增量构建缓存
**/tsconfig.tsbuildinfo

# SSH密钥
*.pem
scripts/data-processing/output/data_bundle.tar.gz

# Data integration pipeline intermediate artifacts (not versioned)
data/_pipeline/

# Git worktrees (isolated workspaces for feature work)
.worktrees/
.claude/worktrees/

# Local scratch artifacts
.clone/
$null
